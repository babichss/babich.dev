---
// A stand-in for BaseLayout.astro, used only by noindex.test.ts: the real
// layout needs Astro.site, which astro/container (experimental_AstroContainer,
// astro@5.16.4) never populates, crashing any container-rendered page that
// uses it. This stub carries just the robots logic that test exercises.
import { defaultLang, isLang, isNoindexLang, type Lang } from "src/lib/i18n";

interface Props {
  noindex?: boolean;
  lang?: Lang;
}

const { noindex = false, lang = defaultLang } = Astro.props;
const pageLang = isLang(lang) ? lang : defaultLang;
---

{
  (noindex || isNoindexLang(pageLang)) && (
    <meta name="robots" content="noindex" />
  )
}
<slot name="head" />
<slot />
