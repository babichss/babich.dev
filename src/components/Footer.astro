---
import { site } from "src/data/site";
import { getLangFromPath } from "src/lib/i18n";

const lang = getLangFromPath(Astro.url.pathname);
const year = new Date().getFullYear();
const isConsulting = Astro.url.pathname.replace(/\/?$/, "/") === "/consulting/";

const links = [
  { href: "mailto:serhii@babich.dev", label: "serhii@babich.dev" },
  { href: "https://www.linkedin.com/in/babichss", label: "LinkedIn" },
  { href: "https://youtube.com/@babichweb", label: "YouTube" },
];
---

<footer class="page-container site-footer">
  <div class="footer-content">
    <div class="footer-group">
      <span class="text-soft">© {year} {site[lang].name}</span>
      {
        lang === "en" && (
          <span class="footer-item">
            <span class="text-soft" aria-hidden="true">
              ·
            </span>
            <a
              class="link-plain"
              href="/consulting/"
              aria-current={isConsulting ? "page" : undefined}
            >
              Technical interviews
            </a>
          </span>
        )
      }
    </div>
    <div class="footer-group">
      {
        links.map(({ href, label }, i) => (
          <span class="footer-item">
            {i > 0 && (
              <span class="text-soft" aria-hidden="true">
                ·
              </span>
            )}
            <a class="link-plain" href={href}>
              {label}
            </a>
          </span>
        ))
      }
    </div>
  </div>
</footer>

<style>
  @layer components {
    .footer-content {
      display: flex;
      flex-direction: column-reverse;
      gap: 4px;
      border-top: 1px solid var(--rule-subtle);
      padding-block: var(--space-2) var(--space-3);
      font-size: 14px;
      line-height: 20px;
    }

    .footer-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 8px;
    }

    /* A dot and its link wrap as one unit, so a dot never sits alone at a
       line edge. */
    .footer-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .footer-item a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-target);
      color: var(--text-2);
    }

    .footer-item a:hover {
      color: var(--accent);
    }

    @media (min-width: 1024px) {
      .footer-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
        padding-block: var(--space-3) var(--space-4);
      }

      .footer-item a {
        min-height: 0;
      }
    }
  }
</style>
