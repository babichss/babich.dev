---
import { site } from "src/data/site";
import { getLangFromPath } from "src/lib/i18n";

const lang = getLangFromPath(Astro.url.pathname);
const year = new Date().getFullYear();
const isConsulting = Astro.url.pathname.replace(/\/?$/, "/") === "/consulting/";

const links = [
  { href: "mailto:serhii@babich.dev", label: "serhii@babich.dev" },
  { href: "https://www.linkedin.com/in/babichss", label: "LinkedIn" },
  { href: "https://youtube.com/@babichweb", label: "YouTube" },
];
---

<footer class="page-container site-footer">
  <div class="footer-content">
    <div class="footer-group">
      <div class="footer-list">
        <span class="footer-item text-soft">© {year} {site[lang].name}</span>
        {
          lang === "en" && (
            <span class="footer-item">
              <a
                class="link-plain"
                href="/consulting/"
                aria-current={isConsulting ? "page" : undefined}
              >
                Technical interviews
              </a>
            </span>
          )
        }
      </div>
    </div>
    <div class="footer-group">
      <div class="footer-list">
        {
          links.map(({ href, label }) => (
            <span class="footer-item">
              <a class="link-plain" href={href}>
                {label}
              </a>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  @layer components {
    .footer-content {
      display: flex;
      flex-direction: column-reverse;
      gap: 4px;
      border-top: 1px solid var(--rule-subtle);
      padding-block: var(--space-2) var(--space-3);
      font-size: 14px;
      line-height: 20px;
    }

    /* Every item carries a leading dot in a 16px gutter. The list is pulled
       left by one gutter and the group clips it, so the dot of whichever item
       starts a line is cut off and a dot never leads or trails a line. The
       padding keeps focus rings inside the clip. */
    .footer-group {
      margin-block: -3px;
      padding-block: 3px;
      overflow: hidden;
    }

    .footer-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin-inline-start: -16px;
    }

    .footer-item {
      position: relative;
      padding-inline-start: 16px;
      white-space: nowrap;
    }

    .footer-item::before {
      position: absolute;
      inset-inline-start: 0;
      width: 16px;
      content: "·";
      content: "·" / "";
      color: var(--text-3);
      text-align: center;
    }

    .footer-item a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-target);
      color: var(--text-2);
    }

    .footer-item a:hover {
      color: var(--accent);
    }

    @media (min-width: 1024px) {
      .footer-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
        padding-block: var(--space-3) var(--space-4);
      }

      .footer-item a {
        min-height: 0;
      }
    }
  }
</style>
