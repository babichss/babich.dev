---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={`icon ${className || ""}`.trim()}
  aria-hidden="true"
  focusable="false"
>
  <use href={`/svg/icons.svg#${name}`}></use>
</svg>

<style>
  @layer components {
    .icon {
      width: var(--space-2);
      height: var(--space-2);

      h3:has(&) {
        display: flex;
        align-items: start;
        gap: var(--space-1);
      }

      a:has(&) {
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
    }
  }
</style>
