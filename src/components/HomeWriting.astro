---
import { getCollection } from "astro:content";
import BlogPostList from "src/components/BlogPostList.astro";
import { getPostsForLang, sortPostsByDate } from "src/lib/blog";
import { localizedPath, type Lang } from "src/lib/i18n";

interface Props {
  lang: Lang;
  cta: string;
}

const { lang, cta } = Astro.props;

const posts = sortPostsByDate(
  getPostsForLang(await getCollection("blog"), lang),
).slice(0, 3);
---

<BlogPostList posts={posts} lang={lang} headingLevel={3} />

<a href={localizedPath(lang, "/blog")} class="cta">{cta}</a>
