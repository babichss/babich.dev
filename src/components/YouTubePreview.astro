---
import { getVideoId } from "src/lib/youtube";

interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;

const videoId = getVideoId(href);

if (href && !videoId) {
  // A silently-empty card is invisible in review; a bad href should fail the build instead.
  throw new Error(
    `YouTubePreview: could not extract a video id from "${href}"`,
  );
}
---

{
  videoId && (
    <a
      class="youtube-preview"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="youtube-preview-media">
        <img
          src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
          data-fallback-src={`https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="youtube-preview-play" aria-hidden="true" />
      </span>
      <span class="youtube-preview-title">{title}</span>
    </a>
  )
}

<script>
  // "error" doesn't bubble, so listen on the capturing phase instead.
  document.addEventListener(
    "error",
    (event) => {
      const img = event.target;

      if (!(img instanceof HTMLImageElement) || !img.dataset.fallbackSrc) {
        return;
      }

      img.src = img.dataset.fallbackSrc;
      delete img.dataset.fallbackSrc;
    },
    true,
  );
</script>

<style>
  @layer components {
    .youtube-preview {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--spacing-sm);
      margin-block: var(--spacing-lg) var(--spacing-xxl);
      /* Caps at 800px against the page column, not the narrower measure-copy parent it sits in. */
      width: min(800px, var(--page-width));
      color: inherit;
    }

    .youtube-preview:visited {
      color: inherit;
    }

    .youtube-preview:hover {
      color: var(--action-hover);
    }

    .youtube-preview-media {
      display: block;
      position: relative;
      background: var(--surface-secondary);
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .youtube-preview-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .youtube-preview-play {
      position: absolute;
      transform: translate(-50%, -50%);
      inset: 50% auto auto 50%;
      border-radius: 8px;
      background: rgb(0 0 0 / 0.72);
      width: 48px;
      height: 34px;
    }

    .youtube-preview-play::before {
      position: absolute;
      transform: translate(-35%, -50%);
      inset: 50% auto auto 50%;
      border-left: 13px solid white;
      border-block: 8px solid transparent;
      content: "";
    }

    .youtube-preview-title {
      font-weight: 700;
      line-height: 1.25;
    }
  }
</style>
