---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;

const getVideoId = (href: string) => {
  const url = new URL(href);

  if (url.hostname === "youtu.be") {
    return url.pathname.slice(1);
  }

  return url.searchParams.get("v");
};

const videoId = getVideoId(href);
---

{
  videoId && (
    <a
      class="youtube-preview"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="youtube-preview-media">
        <img
          src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
          data-fallback-src={`https://i.ytimg.com/vi/${videoId}/sddefault.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="youtube-preview-play" aria-hidden="true" />
      </span>
      <span class="youtube-preview-title">{title}</span>
    </a>
  )
}

<script>
  // "error" doesn't bubble, so listen on the capturing phase instead.
  document.addEventListener(
    "error",
    (event) => {
      const img = event.target;

      if (!(img instanceof HTMLImageElement) || !img.dataset.fallbackSrc) {
        return;
      }

      img.src = img.dataset.fallbackSrc;
      delete img.dataset.fallbackSrc;
    },
    true,
  );
</script>

<style>
  @layer components {
    .youtube-preview {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--spacing-sm);
      margin-block: var(--spacing-lg) var(--spacing-xxl);
      width: 800px;
      max-width: 100%;
      color: inherit;
    }

    .youtube-preview:visited {
      color: inherit;
    }

    .youtube-preview:hover {
      color: var(--action-hover);
    }

    .youtube-preview-media {
      display: block;
      position: relative;
      background: var(--surface-secondary);
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .youtube-preview-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .youtube-preview-play {
      position: absolute;
      transform: translate(-50%, -50%);
      inset: 50% auto auto 50%;
      border-radius: 8px;
      background: rgb(0 0 0 / 0.72);
      width: 48px;
      height: 34px;
    }

    .youtube-preview-play::before {
      position: absolute;
      transform: translate(-35%, -50%);
      inset: 50% auto auto 50%;
      border-left: 13px solid white;
      border-block: 8px solid transparent;
      content: "";
    }

    .youtube-preview-title {
      font-weight: 700;
      line-height: 1.25;
    }
  }
</style>
