---
import { languageNames, localizedPath, type Lang } from "src/lib/i18n";

interface NavItem {
  // The href is already final: it points at the unprefixed (default-language)
  // page even when rendered in the uk nav.
  unprefixed?: boolean;
  href: string;
  title: string;
}

interface Props {
  nav: NavItem[];
  lang: Lang;
  isCurrent: (item: NavItem) => boolean;
  showLanguageSwitch: boolean;
  alternateLang: Lang;
  pathWithoutLang: string;
  // The masthead-nav divider before the language switch; the mobile popover
  // has no divider of its own.
  withDivider?: boolean;
}

const {
  nav,
  lang,
  isCurrent,
  showLanguageSwitch,
  alternateLang,
  pathWithoutLang,
  withDivider = false,
} = Astro.props;
---

{
  nav.map((item) => (
    <a
      href={item.unprefixed ? item.href : localizedPath(lang, item.href)}
      aria-current={isCurrent(item) ? "page" : undefined}
    >
      {item.title}
    </a>
  ))
}
{
  showLanguageSwitch && (
    <>
      {withDivider && <span class="nav-divider" aria-hidden="true" />}
      <a
        class="language-switch"
        href={localizedPath(alternateLang, pathWithoutLang)}
        hreflang={alternateLang}
        lang={alternateLang}
      >
        {languageNames[alternateLang]}
      </a>
    </>
  )
}
