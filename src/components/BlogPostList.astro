---
import { getPostDatePath, type BlogPost } from "src/lib/blog";
import { dateLocales, localizedPath, type Lang } from "src/lib/i18n";

interface Props {
  posts: BlogPost[];
  showDate?: boolean;
  lang: Lang;
  headingLevel?: 2 | 3;
}

const { posts, showDate = true, lang, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<ul class="list-plain blog-post-list rule-stack">
  {
    posts.map((post) => {
      const publishDate = post.data.publishDate;
      const dateLabel = publishDate.toLocaleDateString(dateLocales[lang], {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      const datePath = getPostDatePath(publishDate);

      return (
        <li>
          <article class="blog-post-item">
            {showDate && (
              <footer class="flush text-soft">
                <time class="body-sm" datetime={publishDate.toISOString()}>
                  <a href={localizedPath(lang, `/blog/${datePath}`)}>
                    {dateLabel}
                  </a>
                </time>
              </footer>
            )}

            <Heading class="body-lg flush blog-post-title">
              <a href={localizedPath(lang, `/blog/${post.data.urlSlug}`)}>
                {post.data.title}
              </a>
            </Heading>
            <p class="flush text-secondary">{post.data.description}</p>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  @layer components {
    .blog-post-list {
      --rule-gap: calc(var(--spacing-lg) * 2);
      --rule-color: var(--border-subtle);
    }

    .blog-post-item {
      display: grid;
      gap: var(--spacing-xs);
    }

    .blog-post-item time a {
      color: var(--text-soft);
      text-decoration: none;
    }

    .blog-post-title {
      font-weight: 700;
      line-height: var(--line-height-tight);
    }

    .blog-post-title a {
      text-decoration: none;
    }

    .blog-post-item > p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>
