---
interface Post {
  data: {
    title: string;
    description: string;
    urlSlug: string;
    publishDate: Date;
  };
}

interface Props {
  posts: Post[];
  showDate?: boolean;
}

const { posts, showDate = true } = Astro.props;
---

<ul class="stack gap-md list-plain blog-post-list">
  {
    posts.map((post) => {
      const publishDate = post.data.publishDate;
      const dateLabel = publishDate.toLocaleDateString("uk-UA", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      const datePath = `${publishDate.getFullYear()}/${String(
        publishDate.getMonth() + 1,
      ).padStart(2, "0")}/${String(publishDate.getDate()).padStart(2, "0")}`;

      return (
        <li>
          <article class="blog-post-item">
            {showDate && (
              <footer class="flush text-soft">
                <time class="body-sm" datetime={publishDate.toISOString()}>
                  <a href={`/blog/${datePath}`}>{dateLabel}</a>
                </time>
              </footer>
            )}

            <h2 class="body-lg flush blog-post-title">
              <a href={`/blog/${post.data.urlSlug}`}>{post.data.title}</a>
            </h2>
            <p class="flush text-secondary">{post.data.description}</p>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  @layer components {
    .blog-post-item {
      display: grid;
      gap: var(--spacing-xs);
      border-top: 1px solid color-mix(in hsl, currentColor 7%, transparent);
      padding-block: var(--spacing-sm);
    }

    .blog-post-item:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .blog-post-title {
      font-weight: 700;
      line-height: var(--line-height-tight);
    }
  }
</style>
