---
import { dateLocales, localizedPath, type Lang } from "../lib/i18n";

interface Post {
  data: {
    title: string;
    description: string;
    urlSlug: string;
    publishDate: Date;
    lang: Lang;
  };
}

interface Props {
  posts: Post[];
  showDate?: boolean;
  lang: Lang;
}

const { posts, showDate = true, lang } = Astro.props;
---

<ul class="list-plain blog-post-list">
  {
    posts.map((post) => {
      const publishDate = post.data.publishDate;
      const dateLabel = publishDate.toLocaleDateString(dateLocales[lang], {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      const datePath = `${publishDate.getFullYear()}/${String(
        publishDate.getMonth() + 1,
      ).padStart(2, "0")}/${String(publishDate.getDate()).padStart(2, "0")}`;

      return (
        <li>
          <article class="blog-post-item">
            {showDate && (
              <footer class="flush text-soft">
                <time class="body-sm" datetime={publishDate.toISOString()}>
                  <a href={localizedPath(lang, `/blog/${datePath}`)}>
                    {dateLabel}
                  </a>
                </time>
              </footer>
            )}

            <h2 class="body-lg flush blog-post-title">
              <a href={localizedPath(lang, `/blog/${post.data.urlSlug}`)}>
                {post.data.title}
              </a>
            </h2>
            <p class="flush text-secondary">{post.data.description}</p>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  @layer base, type, layout, components, styles;

  @layer components {
    .blog-post-list {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-lg) * 2);
      row-rule: 1px solid var(--border-subtle);
      row-rule-visibility-items: between;
    }

    .blog-post-item {
      display: grid;
      gap: var(--spacing-xs);
    }

    .blog-post-item time a {
      color: var(--text-soft);
    }

    .blog-post-title {
      font-weight: 700;
      line-height: var(--line-height-tight);
    }

    .blog-post-item > p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>
