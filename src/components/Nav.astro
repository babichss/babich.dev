---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { getLangFromPath, localizedPath, stripLangFromPath } from "../lib/i18n";

const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const content = site[lang];
const nav = content.nav;
const { variant = "all" } = Astro.props;
const showMobile = variant !== "desktop";
const showDesktop = variant !== "mobile";
const pathWithoutLang = stripLangFromPath(currentPath);

const isCurrent = (href: string) => {
  if (href === "/") {
    return pathWithoutLang === "/";
  }

  return pathWithoutLang === href || pathWithoutLang.startsWith(`${href}/`);
};
---

{
  showMobile && (
    <header class="mobile-masthead">
      <div class="mobile-title">
        <button
          class="menu-button"
          type="button"
          aria-label={content.menuLabel}
          popovertarget="menu-mobile"
          popovertargetaction="show"
        >
          <Icon name="menu" />
        </button>
        <a href={localizedPath(lang, "/")} class="site-title body-lg">
          {content.title}
        </a>
      </div>

      <nav id="menu-mobile" aria-label={content.navLabel} popover="auto">
        {nav.map(({ href, title }) => (
          <a
            href={localizedPath(lang, href)}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {title}
          </a>
        ))}
      </nav>
    </header>
  )
}

{
  showDesktop && (
    <header class="masthead">
      <div class="masthead-brand">
        <a href={localizedPath(lang, "/")} class="site-title body-lg">
          {content.title}
        </a>
        <p class="text-secondary">{content.tagline}</p>
      </div>

      <nav aria-label={content.navLabel} class="masthead-nav">
        {nav.map(({ href, title }) => (
          <a
            href={localizedPath(lang, href)}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {title}
          </a>
        ))}
      </nav>
    </header>
  )
}

<style>
  @layer base, type, layout, components, styles;

  @layer components {
    .mobile-masthead {
      display: none;
    }

    .masthead {
      position: sticky;
      top: 0;
      z-index: 1;
      background-color: var(--surface-primary);
      padding-inline: var(--page-gutter);
      padding-top: var(--spacing-xl);
    }

    .masthead-brand {
      border-bottom: 1px solid var(--border-primary);
      padding-bottom: var(--spacing-lg);
    }

    .site-title {
      color: var(--text-primary);
      font-weight: 900;
      text-decoration: none;
      white-space: nowrap;
    }

    .masthead-brand p {
      margin-top: var(--spacing-xs);
    }

    .masthead-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--spacing-xl);
      border-bottom: 1px solid var(--border-primary);
      padding-block: var(--spacing-lg);
    }

    .masthead-nav a {
      color: var(--text-primary);
      text-decoration: none;
    }

    .masthead-nav a[aria-current="page"] {
      color: var(--accent-primary);
      text-decoration: underline;
      text-decoration-color: currentColor;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.35em;
    }

    @media (max-width: 960px) {
      .mobile-masthead {
        display: block;
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--surface-primary);
      }

      .mobile-title {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding-inline: var(--page-gutter);
        padding-block: var(--spacing-md);
      }

      .menu-button {
        display: inline-grid;
        place-items: center;
        border: 0;
        background: transparent;
        padding: 0;
        color: var(--text-primary);
      }

      #menu-mobile {
        margin: 0;
        border: 0;
        background-color: var(--surface-primary);
        padding: var(--page-gutter);
        color: var(--text-primary);

        &::backdrop {
          background-color: color-mix(
            in hsl,
            var(--text-primary) 18%,
            transparent
          );
        }

        a {
          display: block;
          color: var(--text-primary);
          text-decoration: none;
        }

        a + a {
          margin-top: var(--spacing-lg);
        }

        a[aria-current="page"] {
          color: var(--accent-primary);
          text-decoration: underline;
          text-decoration-thickness: 2px;
          text-underline-offset: 0.35em;
        }
      }

      .masthead {
        display: none;
      }
    }
  }
</style>
