---
import NavLinks from "src/components/NavLinks.astro";
import { site } from "src/data/site";
import {
  getAlternateLang,
  getLangFromPath,
  linksToAlternateLang,
  localizedPath,
  stripLangFromPath,
} from "src/lib/i18n";

interface Props {
  hideLanguageSwitch?: boolean;
}

const { hideLanguageSwitch = false } = Astro.props;

const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const content = site[lang];
const nav = content.nav;
const pathWithoutLang = stripLangFromPath(currentPath);
const alternateLang = getAlternateLang(lang);
const showLanguageSwitch = !hideLanguageSwitch && linksToAlternateLang(lang);

// A cross-language item (the UK nav's Work/CV) is `unprefixed` and compares
// against its raw href; the rest resolve through the current language.
const isCurrent = ({
  href,
  unprefixed,
}: {
  href: string;
  unprefixed?: boolean;
}) => {
  const resolvedHref = unprefixed ? href : localizedPath(lang, href);

  if (resolvedHref === "/") {
    return currentPath === "/";
  }

  // Nav hrefs end in "/"; the request path may or may not.
  const base = resolvedHref.replace(/\/$/, "");
  return currentPath === base || currentPath.startsWith(`${base}/`);
};
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href={localizedPath(lang, "/")} class="link-plain site-title">
      {content.title}
    </a>
    <nav aria-label={content.navLabel}>
      <NavLinks
        nav={nav}
        lang={lang}
        isCurrent={isCurrent}
        showLanguageSwitch={showLanguageSwitch}
        alternateLang={alternateLang}
        pathWithoutLang={pathWithoutLang}
      />
    </nav>
  </div>
</header>

<style>
  @layer components {
    .header-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0 12px;
      border-bottom: 1px solid var(--rule-subtle);
      padding-block: var(--space-1);
      font-size: 15px;
      line-height: 24px;
    }

    .site-title {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-target);
      font-weight: 700;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* :global() — the links render inside NavLinks, a separate component the
       scoped-style compiler doesn't attribute-tag. */
    nav :global(a) {
      display: flex;
      align-items: center;
      padding-inline: var(--space-1);
      min-height: var(--tap-target);
    }

    nav :global(a:last-child) {
      padding-inline-end: 0;
    }

    nav :global(a[aria-current="page"]) {
      color: var(--text-strong);
      text-decoration: underline;
      text-decoration-color: currentColor;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }

    nav :global(.language-switch) {
      color: var(--text-3);
    }

    nav :global(a:hover) {
      color: var(--accent);
    }

    @media (min-width: 1024px) {
      .header-inner {
        align-items: baseline;
        padding-block: var(--space-4) var(--space-3);
        font-size: 16px;
      }

      .site-title {
        min-height: 0;
      }

      nav {
        gap: var(--space-3);
      }

      nav :global(a) {
        display: inline;
        padding-inline: 0;
        min-height: 0;
      }
    }
  }
</style>
