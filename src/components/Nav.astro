---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import {
  getAlternateLang,
  getLangFromPath,
  languageNames,
  localizedPath,
  stripLangFromPath,
} from "../lib/i18n";

const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const content = site[lang];
const nav = content.nav;
const pathWithoutLang = stripLangFromPath(currentPath);
const alternateLang = getAlternateLang(lang);
const showLanguageSwitch = pathWithoutLang !== "/interviews/personal";

const isCurrent = (href: string) => {
  if (href === "/") {
    return pathWithoutLang === "/";
  }

  return pathWithoutLang === href || pathWithoutLang.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="mobile-masthead">
      <div class="mobile-title">
        <button
          class="menu-button"
          type="button"
          aria-label={content.menuLabel}
          popovertarget="menu-mobile"
          popovertargetaction="toggle"
        >
          <Icon name="menu" />
        </button>
        <a href={localizedPath(lang, "/")} class="site-title body-lg">
          {content.title}
        </a>
      </div>

      <nav id="menu-mobile" aria-label={content.navLabel} popover="auto">
        {nav.map(({ href, title }) => (
          <a
            href={localizedPath(lang, href)}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {title}
          </a>
        ))}
        {showLanguageSwitch && (
          <a
            class="language-switch"
            href={localizedPath(alternateLang, pathWithoutLang)}
            hreflang={alternateLang}
            lang={alternateLang}
          >
            {languageNames[alternateLang]}
          </a>
        )}
      </nav>
  </div>

  <div class="masthead">
      <div class="masthead-brand">
        <a href={localizedPath(lang, "/")} class="site-title body-lg">
          {content.title}
        </a>
        <p class="text-secondary">{content.tagline}</p>
      </div>

      <nav aria-label={content.navLabel} class="masthead-nav">
        {nav.map(({ href, title }) => (
          <a
            href={localizedPath(lang, href)}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {title}
          </a>
        ))}
        {showLanguageSwitch && (
          <>
            <span class="nav-divider" aria-hidden="true" />
            <a
              class="language-switch"
              href={localizedPath(alternateLang, pathWithoutLang)}
              hreflang={alternateLang}
              lang={alternateLang}
            >
              {languageNames[alternateLang]}
            </a>
          </>
        )}
      </nav>
  </div>
</header>

<style>
  @layer base, type, layout, components, styles;

  @layer components {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .mobile-masthead {
      display: none;
    }

    .masthead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--spacing-xl);
      margin-inline: auto;
      border-bottom: 1px solid var(--border-primary);
      background-color: var(--surface-primary);
      padding-block: var(--spacing-md);
      width: var(--page-width);
    }

    .masthead-brand {
      min-width: 0;
    }

    .site-title {
      color: var(--text-primary);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .masthead-brand p {
      margin-top: var(--spacing-xs);
      margin-bottom: 0;
      font-size: var(--body-sm);
      white-space: nowrap;
    }

    .masthead-nav {
      display: flex;
      align-items: center;
      gap: var(--spacing-lg);
      white-space: nowrap;
    }

    .masthead-nav a {
      color: var(--text-primary);
      text-decoration: none;
    }

    .masthead-nav a[aria-current="page"] {
      color: var(--accent-primary);
      text-decoration: underline;
      text-decoration-color: currentColor;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.35em;
    }

    .nav-divider {
      flex: none;
      background: var(--border-primary);
      width: 1px;
      height: 1em;
    }

    .masthead-nav .language-switch {
      color: var(--text-secondary);
    }

    @media (max-width: 960px) {
      .mobile-masthead {
        display: block;
        border-bottom: 1px solid var(--border-primary);
        background-color: var(--surface-primary);
      }

      .mobile-title {
        display: flex;
        align-items: center;
        gap: 0;
        margin-inline: auto;
        width: var(--page-width);
        height: 60px;
      }

      .menu-button {
        display: inline-grid;
        place-items: center;
        border: 0;
        background: transparent;
        padding: 0;
        width: 44px;
        height: 44px;
        color: var(--text-primary);
      }

      #menu-mobile {
        position: fixed;
        margin: 0;
        inset: 60px 0 auto;
        border: 0;
        border-bottom: 1px solid var(--border-primary);
        background-color: var(--surface-primary);
        padding: var(--spacing-sm) calc((100vw - var(--page-width)) / 2)
          var(--spacing-md);
        width: 100vw;
        max-width: none;
        color: var(--text-primary);

        &::backdrop {
          background-color: color-mix(
            in hsl,
            var(--text-primary) 18%,
            transparent
          );
        }

        a {
          display: flex;
          align-items: center;
          min-height: 44px;
          color: var(--text-primary);
          text-decoration: none;
        }

        a[aria-current="page"] {
          color: var(--accent-primary);
          text-decoration: underline;
          text-decoration-thickness: 2px;
          text-underline-offset: 0.35em;
        }

        .language-switch {
          margin-top: var(--spacing-sm);
          border-top: 1px solid var(--border-primary);
          color: var(--text-secondary);
        }
      }

      .masthead {
        display: none;
      }
    }
  }
</style>
