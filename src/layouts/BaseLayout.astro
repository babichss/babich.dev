---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/type.css";
import "../styles/global.css";
import Footer from "src/components/Footer.astro";
import { site } from "src/data/site";
import {
  defaultLang,
  getAlternateLang,
  isLang,
  localizedPath,
  stripLangFromPath,
  type Lang,
} from "src/lib/i18n";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  // Set on a page with no translated counterpart, so this layout never
  // advertises a hreflang alternate that 404s.
  noAlternateLang?: boolean;
  // Set on the service pages hidden from nav/home during the job search;
  // keeps them out of search results without deleting them.
  noindex?: boolean;
  // Lets a page scope its own CSS (e.g. the /cv print stylesheet) without
  // the shared, code-split-free bundle leaking those rules everywhere.
  bodyClass?: string;
}

const {
  title,
  description,
  lang = "uk",
  noAlternateLang = false,
  noindex = false,
  bodyClass,
} = Astro.props;
const pageLang = isLang(lang) ? lang : defaultLang;
const siteName = site[pageLang].name;
const pageTitle = `${siteName} • ${title}`;

const alternateLang = getAlternateLang(pageLang);
const pathWithoutLang = stripLangFromPath(Astro.url.pathname);
const urlFor = (forLang: Lang) =>
  new URL(localizedPath(forLang, pathWithoutLang), Astro.site).href;
const canonicalURL = urlFor(pageLang);
const ogImageURL = new URL("/og.jpg", Astro.site).href;

const ogLocales: Record<Lang, string> = { uk: "uk_UA", en: "en_US" };
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline>
      @layer base, type, layout, components, styles;
    </style>
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={pageLang} href={canonicalURL} />
    {
      !noAlternateLang && (
        <link
          rel="alternate"
          hreflang={alternateLang}
          href={urlFor(alternateLang)}
        />
      )
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={noAlternateLang ? canonicalURL : urlFor(defaultLang)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocales[pageLang]} />
    {
      !noAlternateLang && (
        <meta
          property="og:locale:alternate"
          content={ogLocales[alternateLang]}
        />
      )
    }
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=JetBrains+Mono:wght@400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=JetBrains+Mono:wght@400&display=swap"
      />
    </noscript>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <Footer />
  </body>
</html>
