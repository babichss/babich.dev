---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/type.css";
import "../styles/global.css";
import { site } from "../data/site";
import { defaultLang, isLang, type Lang } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = "uk" } = Astro.props;
const pageLang = isLang(lang) ? lang : defaultLang;
const siteName = site[pageLang].name;
const pageTitle = `${siteName} • ${title}`;
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.webp" type="image/x-icon" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Sono:wght,MONO@200..800,1&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
