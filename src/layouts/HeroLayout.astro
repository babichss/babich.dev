---

---

<slot name="header" />

<main class="page-container home-content rule-stack">
  <slot name="content" />
</main>

<style>
  @layer styles {
    .home-content {
      --rule-inset: 0 max(0px, calc(100% - var(--measure-copy)));
    }

    .home-content :global(.hero) {
      display: grid;
      grid-template:
        "title image" auto
        "intro image" 1fr /
        minmax(0, 1fr) min(20rem, 40%);
      gap: calc(var(--section-space) / 2) var(--section-space);
    }

    .home-content :global(.hero header) {
      grid-area: title;
    }

    .home-content :global(.hero section) {
      grid-area: intro;
      align-self: start;
      width: min(100%, var(--measure-copy));
    }

    .home-content > :global(section) {
      width: min(100%, var(--measure-copy));
    }

    .home-content :global(.hero .home-portrait) {
      display: block;
      grid-area: image;
      justify-self: end;
      aspect-ratio: 3 / 4;
      width: 100%;
      height: auto;
      object-fit: cover;
      object-position: 50% 28%;
    }

    @media (max-width: 960px) {
      .home-content :global(.hero) {
        grid-template:
          "title" auto
          "intro" auto
          "image" auto /
          1fr;
      }

      .home-content :global(.hero .home-portrait) {
        justify-self: start;
        width: min(100%, 20rem);
      }
    }
  }
</style>
