---

---

<slot name="header" />

<main class="page-container home-content rule-stack">
  <slot name="content" />
</main>

<style>
  @layer styles {
    .home-content {
      --rule-inset: 0 max(0px, calc(100% - var(--measure-copy)));
    }

    .home-content :global(.hero) {
      display: grid;
      grid-template:
        "title image" auto
        "intro image" auto
        "lead  image" auto /
        minmax(0, 1fr) min(20rem, 40%);
      align-items: start;
      gap: calc(var(--section-space) / 2) var(--section-space);
    }

    .home-content :global(.hero header) {
      grid-area: title;
    }

    .home-content :global(.hero .hero-intro),
    .home-content :global(.hero .hero-lead) {
      width: min(100%, var(--measure-copy));
    }

    .home-content :global(.hero .hero-intro) {
      grid-area: intro;
    }

    /* The main stack's divider no longer falls between the hero and this
       section, so draw it here. Half the gap (from the grid) plus half
       padding matches the rule-stack spacing. */
    .home-content :global(.hero .hero-lead) {
      grid-area: lead;
      border-top: 1px solid var(--rule-color);
      padding-top: calc(var(--rule-gap) / 2);
    }

    .home-content > :global(section) {
      width: min(100%, var(--measure-copy));
    }

    .home-content :global(.hero .home-portrait) {
      display: block;
      grid-area: image;
      aspect-ratio: 3 / 4;
      width: 100%;
      height: auto;
      object-fit: cover;
      object-position: 50% 28%;
    }

    /* 960px squeezes the two-column text column to ~420px before this
       breakpoint would otherwise kick in, so the hero itself drops to a
       single column a bit earlier than the rest of the site's 960px
       breakpoint. */
    @media (max-width: 1100px) {
      .home-content :global(.hero) {
        grid-template:
          "title" auto
          "intro" auto
          "image" auto
          "lead" auto /
          1fr;
      }

      .home-content :global(.hero .home-portrait) {
        justify-self: start;
        width: min(100%, 20rem);
      }
    }

    .home-content :global(.proof-strip) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: var(--spacing-lg) var(--section-space);
      margin: 0;
    }

    .home-content :global(.proof-strip dt) {
      color: var(--text-heading);
      font-weight: 700;
      font-size: var(--body-xl);
    }

    .home-content :global(.proof-strip dd) {
      margin: 0;
      color: var(--text-secondary);
    }
  }
</style>
