---

---

<div class="hero-header">
  <slot name="header" />
</div>

<main class="stack gap-xl">
  <slot name="content" />
</main>

<slot name="hero" />

<style>
  @layer styles {
    body {
      display: grid;
      grid:
        "header portrait"
        "content portrait";
      grid-template-columns: 5fr 4fr;
      grid-template-rows: auto 1fr;

      @media (max-width: 960px) {
        grid:
          "header"
          "portrait"
          "content";
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
      }

      --page-gutter: var(--spacing-xxl);

      @media (max-width: 960px) {
        --page-gutter: var(--spacing-lg);
      }
    }

    .hero-header {
      grid-area: header;
      position: sticky;
      z-index: 1;
      top: 0;
      align-self: start;
    }

    .hero-header :global(.masthead),
    .hero-header :global(.mobile-masthead) {
      position: static;
    }

    main {
      grid-area: content;
      padding-top: var(--spacing-xl);
      padding-inline: var(--page-gutter);
      padding-bottom: var(--spacing-xxl);
    }
  }
</style>
