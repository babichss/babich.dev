---

---

<slot name="header" />

<main class="page-container home-content">
  <slot name="content" />
</main>

<style>
  @layer base, type, layout, components, styles;

  @layer styles {
    .home-content {
      display: flex;
      flex-direction: column;
      gap: var(--section-space);
      row-rule: 1px solid var(--border-primary);
      row-rule-inset: 0 max(0px, calc(100% - var(--measure-copy)));
      row-rule-visibility-items: between;
    }

    @supports not (row-rule: 1px solid red) {
      .home-content {
        gap: calc(var(--section-space) / 2);
      }

      .home-content > :global(* + *) {
        border-top: 1px solid var(--border-primary);
        padding-top: calc(var(--section-space) / 2);
      }
    }

    .home-content :global(.hero) {
      display: grid;
      grid-template:
        "title image" auto
        "intro image" 1fr /
        minmax(0, 1fr) auto;
      gap: calc(var(--section-space) / 2) var(--section-space);
    }

    .home-content :global(.hero header) {
      grid-area: title;
    }

    .home-content :global(.hero section) {
      grid-area: intro;
      align-self: start;
      width: min(100%, var(--measure-copy));
    }

    .home-content > :global(section) {
      width: min(100%, var(--measure-copy));
    }

    .home-content :global(.hero .home-portrait) {
      display: block;
      grid-area: image;
      justify-self: end;
      width: min(100%, 20rem);
      aspect-ratio: 3 / 4;
      height: auto;
      object-fit: cover;
      object-position: 50% 28%;
    }

    @media (max-width: 960px) {
      .home-content :global(.hero) {
        grid-template:
          "title" auto
          "intro" auto
          "image" auto /
          1fr;
      }

      .home-content :global(.hero .home-portrait) {
        justify-self: stretch;
        width: 100%;
      }
    }
  }
</style>
