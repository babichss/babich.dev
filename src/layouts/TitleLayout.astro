---
import Nav from "../components/Nav.astro";
---

<Nav variant="mobile" />

<div class="content-layout">
  <div class="side-column">
    <Nav variant="desktop" />
    <div class="title stack gap-md">
      <slot name="title" />
    </div>
  </div>

  <main class="stack gap-xxl">
    <slot name="content" />
  </main>
</div>

<style>
  @layer base, type, layout, components, styles;

  @layer styles {
    body {
      --page-gutter: var(--spacing-xxl);
      --side-column-width: 37.5vw;

      @media (max-width: 960px) {
        --page-gutter: var(--spacing-lg);
        --side-column-width: 100%;
      }
    }

    .content-layout {
      min-width: 0;
      min-height: 100vh;
    }

    .side-column {
      display: flex;
      position: fixed;
      flex-direction: column;
      inset: 0 auto 0 0;
      width: var(--side-column-width);
      min-width: 0;
      height: 100dvh;
      overflow: auto;

      @media (max-width: 960px) {
        position: static;
        height: auto;
      }
    }

    .title {
      flex: 1;
      padding-inline: var(--page-gutter);
      padding-block: var(--spacing-xl);
      min-width: 0;
    }

    main {
      margin-left: var(--side-column-width);
      padding: var(--spacing-xl) var(--page-gutter) var(--spacing-xxl);
      min-width: 0;

      @media (max-width: 960px) {
        margin-left: 0;
      }
    }
  }
</style>
