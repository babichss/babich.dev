---
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
---

<div class="surface-dark sidebar">
  <Nav />
  <div class="title">
    <slot name="title" />
  </div>
</div>

<main>
  <slot name="content" />
</main>

<style>
  @layer styles {
    body {
      --page-gutter: var(--spacing-xxl);
      display: grid;
      grid-template-columns: 3fr 5fr;
      grid-template-areas: "sidebar content";

      @media (orientation: portrait) {
        --page-gutter: var(--spacing-lg);
        grid:
          "sidebar"
          "content";
      }
    }

    .sidebar {
      display: flex;

      grid-area: sidebar;
      flex-direction: column;
      width: stretch;
      min-width: 0;

      @media (orientation: landscape) {
        position: sticky;
        top: 0;
        height: 100vh;
      }

      @media (orientation: portrait) {
        position: static;
        top: unset;
        height: fit-content;
      }
    }

    .title {
      flex: 1;
      padding: var(--page-gutter);
    }

    main {
      display: flex;
      row-gap: var(--spacing-lg);
      grid-area: content;
      flex-direction: column;
      padding: var(--page-gutter);
      min-width: 0;

      > :is(h2, h3, h4, h5, h6) {
        margin: 0;
      }
    }
  }
</style>
