---
import Nav from "src/components/Nav.astro";

interface Props {
  hideLanguageSwitch?: boolean;
}

const { hideLanguageSwitch = false } = Astro.props;
---

<Nav hideLanguageSwitch={hideLanguageSwitch} />

<main class="page-container page-content rule-stack">
  <header class="title stack gap-md">
    <slot name="title" />
  </header>

  <div class="content rule-stack">
    <slot name="content" />
  </div>
</main>

<style>
  @layer styles {
    .page-content {
      --rule-inset: 0 max(0px, calc(100% - var(--measure-copy)));
    }

    .title,
    .content {
      width: min(100%, var(--measure-copy));
    }

    .content > :global(section),
    .content > :global(article) {
      width: 100%;
    }
  }
</style>
