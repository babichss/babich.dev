---
import Nav from "../components/Nav.astro";
---

<Nav />

<main class="page-container page-content">
  <header class="title stack gap-md">
    <slot name="title" />
  </header>

  <div class="content">
    <slot name="content" />
  </div>
</main>

<style>
  @layer base, type, layout, components, styles;

  @layer styles {
    .page-content {
      display: flex;
      flex-direction: column;
      gap: var(--section-space);
      row-rule: 1px solid var(--border-primary);
      row-rule-inset: 0 max(0px, calc(100% - var(--measure-copy)));
      row-rule-visibility-items: between;
    }

    .title,
    .content {
      width: min(100%, var(--measure-copy));
    }

    .content {
      display: flex;
      flex-direction: column;
      gap: var(--section-space);
      row-rule: 1px solid var(--border-primary);
      row-rule-visibility-items: between;
    }

    .content > :global(section),
    .content > :global(article) {
      width: 100%;
    }

  }
</style>
