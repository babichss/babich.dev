---
import BaseLayout from "../layouts/BaseLayout.astro";

import * as IntroCopy from "./copy/intro.md";
import * as ProcessCopy from "./copy/process.md";
import * as ImportanceCopy from "./copy/importance.md";
import * as UsefulnessCopy from "./copy/usefulness.md";
import * as AboutCopy from "./copy/about.md";
import * as FeedbacksCopy from "./copy/feedbacks.md";
import HeroLayout from "../layouts/HeroLayout.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout title="Сергій Бабіч" description="Сергій Бабіч — технічний експерт">
  <HeroLayout>
    <Fragment slot="header">
      <Nav />
      <Header>
        <h1>Привіт! Я Сергій Бабіч.</h1>
      </Header>
    </Fragment>

    <Fragment slot="content">
      <p>Всяке про мене</p>
    </Fragment>
    <img slot="hero" class="hero" src="assets/hero.webp" alt="Сергій Бабіч" />
  </HeroLayout>
</BaseLayout>

<style>
  @layer styles {
    .feedbacks blockquote {
      box-shadow: 0 0 3px black;
      color: lime;
    }

    .hero {
      position: sticky;
      top: 0;
      grid-area: portrait;
      width: stretch;
      min-width: 0;
      height: 100vh;
      object-fit: cover;
      object-position: top;

      @media (orientation: portrait) {
        position: static;
        height: 50vh;
      }
    }
  }
</style>
