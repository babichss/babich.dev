---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import TitleLayout from "../../layouts/TitleLayout.astro";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");

  return blogPosts.map((post) => ({
    params: { slug: post.data.urlSlug },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content } = await post.render();
const year = post.data.publishDate.getFullYear();
const month = `${post.data.publishDate.getUTCMonth() + 1}`.padStart(2, "0");
const monthName = post.data.publishDate
  .toLocaleDateString("uk-UA", {
    month: "long",
  })
  .replace(/^./, (c) => c.toUpperCase());
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script
    slot="head"
    src="https://cdn.counter.dev/script.js"
    data-id="fc0be846-8fa6-4d1e-aa0c-4645581e1586"
    data-utcoffset="2"></script>

  <TitleLayout>
    <div slot="title" class="stack gap-md">
      <div>
        <a href=`/blog/${year}`> {year}</a>
        /
        <a href=`/blog/${year}/${month}`>
          {monthName}
        </a>
      </div>

      <h1>{post.data.title}</h1>
      <a href="/blog">
        <Icon name="arrow-left" />
        Усі дописи
      </a>
    </div>

    <article slot="content">
      <Content />
    </article>
  </TitleLayout>
</BaseLayout>
