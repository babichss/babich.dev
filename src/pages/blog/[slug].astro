---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import TitleLayout from "../../layouts/TitleLayout.astro";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");

  return blogPosts.map((post) => ({
    params: { slug: post.data.urlSlug },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content } = await post.render();

const dateName = post.data.publishDate
  .toLocaleDateString("uk-UA", {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/^./, (c) => c.toUpperCase());
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script
    slot="head"
    src="https://cdn.counter.dev/script.js"
    data-id="fc0be846-8fa6-4d1e-aa0c-4645581e1586"
    data-utcoffset="2"></script>

  <TitleLayout>
    <div slot="title" class="post-title">
      <div>
        <time datetime={post.data.publishDate.toISOString()}>{dateName}</time>
        <h1>{post.data.title}</h1>
      </div>
      <a href="/blog">
        <Icon name="arrow-left" />
        Усі дописи
      </a>
    </div>

    <article slot="content" class="content">
      <Content />
    </article>
  </TitleLayout>
</BaseLayout>

<style>
  .post-title {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: stretch;
  }
</style>
