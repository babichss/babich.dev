---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Icon from "../../../../../components/Icon.astro";
import BlogPostList from "../../../../../components/BlogPostList.astro";
import TitleLayout from "../../../../../layouts/TitleLayout.astro";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  const dateMap = new Map<string, typeof blogPosts>();

  blogPosts.forEach((post) => {
    const year = post.data.publishDate.getFullYear();
    const month = post.data.publishDate.getMonth() + 1; // 1-12
    const day = post.data.publishDate.getDate();
    const key = `${year}-${month.toString().padStart(2, "0")}-${day
      .toString()
      .padStart(2, "0")}`;

    if (!dateMap.has(key)) {
      dateMap.set(key, []);
    }
    dateMap.get(key)!.push(post);
  });

  return Array.from(dateMap.entries()).map(([key, posts]) => {
    const [year, month, day] = key.split("-");
    const sortedPosts = posts.sort(
      (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
    );

    return {
      params: { year, month, day },
      props: {
        year: parseInt(year),
        month: parseInt(month),
        day: parseInt(day),
        posts: sortedPosts,
      },
    };
  });
}

const { year, month, day, posts } = Astro.props;
const dateName = new Date(year, month - 1, day)
  .toLocaleDateString("uk-UA", {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/\s*р\.$/u, " року");
---

<BaseLayout
  title={`Блоґ | ${dateName}`}
  description={`Всі пости блоґу за ${dateName}`}
>
  <TitleLayout>
    <div slot="title" class="stack gap-md">
      <h1>Усі дописи за {dateName}</h1>
      <a href="/blog">
        <Icon name="arrow-left" />
        Усі дописи
      </a>
    </div>

    <Fragment slot="content">
      <BlogPostList posts={posts} showDate={false} />
    </Fragment>
  </TitleLayout>
</BaseLayout>
