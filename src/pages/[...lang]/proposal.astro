---
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import {
  getLangFromPath,
  getLangStaticPaths,
} from "../../lib/i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].proposal;
const page = (await getCollection("pages")).find(
  (entry) => entry.data.lang === lang && entry.data.page === "proposal",
);

if (!page) {
  throw new Error(`Missing proposal copy for ${lang}`);
}

const { Content } = await render(page);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <Content />
</BaseLayout>
