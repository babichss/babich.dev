---
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import BlogArchiveLayout from "@/layouts/BlogArchiveLayout.astro";
import { getDateGroups, getLangPostGroups } from "@/lib/blog";
import { dateLocales, getLangFromPath, langParam } from "@/lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");

  return getLangPostGroups(blogPosts).flatMap(({ lang, posts }) =>
    getDateGroups(posts, "month").map(({ year, month, posts: monthPosts }) => ({
      params: {
        lang: langParam(lang),
        year: year.toString(),
        month: month!.toString().padStart(2, "0"),
      },
      props: { year, month: month!, posts: monthPosts },
    })),
  );
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { year, month, posts } = Astro.props;
const monthName = new Date(year, month - 1).toLocaleDateString(
  dateLocales[lang],
  { month: "long" },
);
---

<BlogArchiveLayout
  lang={lang}
  title={content.monthTitle(monthName, year)}
  description={content.monthDescription(monthName, year)}
  heading={content.monthHeading(monthName, year)}
  allPostsLabel={content.allPosts}
  emptyMessage={content.monthEmpty(monthName, year)}
  posts={posts}
/>
