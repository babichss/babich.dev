---
import { getCollection } from "astro:content";
import { site } from "src/data/site";
import BlogArchiveLayout from "src/layouts/BlogArchiveLayout.astro";
import {
  getBlogLangGroups,
  getDateGroups,
  hasPostInPeriod,
  padDatePart,
} from "src/lib/blog";
import { dateLocales, getLangFromPath, langParam } from "src/lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  const langGroups = getBlogLangGroups(blogPosts);

  return langGroups.flatMap(({ lang, posts, altPosts }) => {
    return getDateGroups(posts, "day").map(
      ({ year, month, day, posts: dayPosts }) => ({
        params: {
          lang: langParam(lang),
          year: year.toString(),
          month: padDatePart(month!),
          day: padDatePart(day!),
        },
        props: {
          year,
          month: month!,
          day: day!,
          posts: dayPosts,
          noAlternateLang: !hasPostInPeriod(altPosts, year, month, day),
        },
      }),
    );
  });
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { year, month, day, posts, noAlternateLang } = Astro.props;
const dateName = new Date(year, month - 1, day)
  .toLocaleDateString(dateLocales[lang], {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/\s*р\.$/u, " року");
---

<BlogArchiveLayout
  lang={lang}
  title={content.dayTitle(dateName)}
  description={content.dayDescription(dateName)}
  heading={content.dayHeading(dateName)}
  allPostsLabel={content.allPosts}
  posts={posts}
  showDate={false}
  noAlternateLang={noAlternateLang}
/>
