---
import { getCollection } from "astro:content";
import { site } from "../../../../../../data/site";
import BlogArchiveLayout from "../../../../../../layouts/BlogArchiveLayout.astro";
import { getDateGroups, getLangPostGroups } from "../../../../../../lib/blog";
import {
  dateLocales,
  getLangFromPath,
  langParam,
} from "../../../../../../lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");

  return getLangPostGroups(blogPosts).flatMap(({ lang, posts }) =>
    getDateGroups(posts, "day").map(
      ({ year, month, day, posts: dayPosts }) => ({
        params: {
          lang: langParam(lang),
          year: year.toString(),
          month: month!.toString().padStart(2, "0"),
          day: day!.toString().padStart(2, "0"),
        },
        props: { year, month: month!, day: day!, posts: dayPosts },
      }),
    ),
  );
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { year, month, day, posts } = Astro.props;
const dateName = new Date(year, month - 1, day)
  .toLocaleDateString(dateLocales[lang], {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/\s*р\.$/u, " року");
---

<BlogArchiveLayout
  lang={lang}
  title={content.dayTitle(dateName)}
  description={content.dayDescription(dateName)}
  heading={content.dayHeading(dateName)}
  allPostsLabel={content.allPosts}
  posts={posts}
  showDate={false}
/>
