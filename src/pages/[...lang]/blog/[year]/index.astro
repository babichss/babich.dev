---
import { getCollection } from "astro:content";
import { site } from "src/data/site";
import BlogArchiveLayout from "src/layouts/BlogArchiveLayout.astro";
import {
  getBlogLangGroups,
  getDateGroups,
  hasPostInPeriod,
} from "src/lib/blog";
import { getLangFromPath, langParam } from "src/lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  const langGroups = getBlogLangGroups(blogPosts);

  return langGroups.flatMap(({ lang, posts, altPosts }) => {
    return getDateGroups(posts, "year").map(({ year, posts: yearPosts }) => ({
      params: { lang: langParam(lang), year: year.toString() },
      props: {
        year,
        posts: yearPosts,
        noAlternateLang: !hasPostInPeriod(altPosts, year),
      },
    }));
  });
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { year, posts, noAlternateLang } = Astro.props;
---

<BlogArchiveLayout
  lang={lang}
  title={content.yearTitle(year)}
  description={content.yearDescription(year)}
  heading={content.yearHeading(year)}
  allPostsLabel={content.allPosts}
  emptyMessage={content.yearEmpty(year)}
  posts={posts}
  noAlternateLang={noAlternateLang}
/>
