---
import { getCollection } from "astro:content";
import Icon from "src/components/Icon.astro";
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import TitleLayout from "src/layouts/TitleLayout.astro";
import {
  getBlogLangGroups,
  hasPostWithSlug,
  sortPostsByDate,
} from "src/lib/blog";
import {
  dateLocales,
  defaultLang,
  getLangFromPath,
  langParam,
  localizedPath,
} from "src/lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  const langGroups = getBlogLangGroups(blogPosts);

  return langGroups.flatMap(({ lang, posts, altPosts }) => {
    return sortPostsByDate(posts).map((post) => ({
      params: { lang: langParam(lang), slug: post.data.urlSlug },
      props: {
        post,
        noAlternateLang: !hasPostWithSlug(altPosts, post.data.urlSlug),
      },
    }));
  });
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { post, noAlternateLang } = Astro.props;
const { Content } = await post.render();

const dateName = post.data.publishDate
  .toLocaleDateString(dateLocales[lang], {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/^./, (c) => c.toUpperCase());

const siteURL = Astro.site ?? Astro.url;
const titleSuffix = `${post.data.title} | ${site[lang].name}`.length <= 60;
const postURL = new URL(
  localizedPath(lang, `/blog/${post.data.urlSlug}/`),
  siteURL,
).href;
const publishedTime = post.data.publishDate.toISOString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${postURL}#article`,
  mainEntityOfPage: postURL,
  url: postURL,
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedTime,
  inLanguage: lang,
  image: new URL("/og.jpg", siteURL).href,
  author: {
    "@type": "Person",
    "@id": new URL("/#person", siteURL).href,
    name: site.en.name,
    url: new URL("/", siteURL).href,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  noAlternateLang={noAlternateLang}
  titleSuffix={titleSuffix}
  ogType="article"
  publishedTime={publishedTime}
>
  <Fragment slot="head">
    {
      lang === defaultLang && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </Fragment>
  <script
    slot="head"
    src="https://cdn.counter.dev/script.js"
    data-id="fc0be846-8fa6-4d1e-aa0c-4645581e1586"
    data-utcoffset="2"></script>

  <TitleLayout hideLanguageSwitch={noAlternateLang}>
    <div slot="title" class="post-title stack gap-md">
      <div class="stack gap-sm">
        <time
          class="body-sm text-soft"
          datetime={post.data.publishDate.toISOString()}>{dateName}</time
        >
        <h1>{post.data.title}</h1>
      </div>
      <a href={localizedPath(lang, "/blog/")}>
        <Icon name="arrow-left" />
        {content.allPosts}
      </a>
    </div>

    <article slot="content">
      <Content />
    </article>
  </TitleLayout>
</BaseLayout>
