---
import { getCollection } from "astro:content";
import Icon from "src/components/Icon.astro";
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import TitleLayout from "src/layouts/TitleLayout.astro";
import { getLangPostGroups, sortPostsByDate } from "src/lib/blog";
import {
  dateLocales,
  getLangFromPath,
  langParam,
  localizedPath,
} from "src/lib/i18n";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");

  return getLangPostGroups(blogPosts).flatMap(({ lang, posts }) =>
    sortPostsByDate(posts).map((post) => ({
      params: { lang: langParam(lang), slug: post.data.urlSlug },
      props: { post },
    })),
  );
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const { post } = Astro.props;
const { Content } = await post.render();

const dateName = post.data.publishDate
  .toLocaleDateString(dateLocales[lang], {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  .replace(/^./, (c) => c.toUpperCase());
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
>
  <script
    slot="head"
    src="https://cdn.counter.dev/script.js"
    data-id="fc0be846-8fa6-4d1e-aa0c-4645581e1586"
    data-utcoffset="2"></script>

  <TitleLayout>
    <div slot="title" class="post-title stack gap-md">
      <div class="stack gap-sm">
        <time
          class="body-sm text-soft"
          datetime={post.data.publishDate.toISOString()}>{dateName}</time
        >
        <h1>{post.data.title}</h1>
      </div>
      <a href={localizedPath(lang, "/blog")}>
        <Icon name="arrow-left" />
        {content.allPosts}
      </a>
    </div>

    <article slot="content">
      <Content />
    </article>
  </TitleLayout>
</BaseLayout>
