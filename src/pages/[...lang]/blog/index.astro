---
import { getCollection } from "astro:content";
import BlogPostList from "../../../components/BlogPostList.astro";
import { site } from "../../../data/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TitleLayout from "../../../layouts/TitleLayout.astro";
import { getPostsForLang, sortPostsByDate } from "../../../lib/blog";
import {
  dateLocales,
  getLangFromPath,
  getLangStaticPaths,
  localizedPath,
} from "../../../lib/i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const blogPosts = getPostsForLang(await getCollection("blog"), lang);
const sortedPosts = sortPostsByDate(blogPosts);

const groupedPosts = sortedPosts.reduce(
  (acc, post) => {
    const year = post.data.publishDate.getFullYear();
    const month = post.data.publishDate.getMonth() + 1;
    const monthName = post.data.publishDate.toLocaleDateString(
      dateLocales[lang],
      { month: "long" },
    );
    const key = `${year}-${month}`;

    if (!acc[key]) {
      acc[key] = {
        year,
        month,
        monthName,
        posts: [],
      };
    }

    acc[key].posts.push(post);
    return acc;
  },
  {} as Record<
    string,
    {
      year: number;
      month: number;
      monthName: string;
      posts: typeof blogPosts;
    }
  >,
);

const groupedArray = Object.values(groupedPosts).sort((a, b) => {
  if (a.year !== b.year) return b.year - a.year;
  return (
    b.posts[0].data.publishDate.getTime() -
    a.posts[0].data.publishDate.getTime()
  );
});
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <TitleLayout>
    <div slot="title" class="stack gap-md">
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
      <p>{content.thanks}</p>
    </div>

    <Fragment slot="content">
      {
        groupedArray.length === 0 ? (
          <p>{content.empty}</p>
        ) : (
          groupedArray.map((group) => {
            const monthPadded = group.month.toString().padStart(2, "0");
            return (
              <section class="stack gap-md blog-group">
                <h2 class="body-sm text-soft blog-group-title">
                  <a
                    href={localizedPath(
                      lang,
                      `/blog/${group.year}/${monthPadded}`,
                    )}
                  >
                    {group.monthName} {group.year}
                  </a>
                </h2>
                <BlogPostList posts={group.posts} lang={lang} />
              </section>
            );
          })
        )
      }
    </Fragment>
  </TitleLayout>
</BaseLayout>

<style>
  @layer base, type, layout, components, styles;

  @layer styles {
    .blog-group-title {
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }
</style>
