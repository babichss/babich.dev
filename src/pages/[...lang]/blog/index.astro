---
import { getCollection } from "astro:content";
import BlogPostList from "@/components/BlogPostList.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TitleLayout from "@/layouts/TitleLayout.astro";
import { getDateGroups, getPostsForLang, sortPostsByDate } from "@/lib/blog";
import {
  dateLocales,
  getLangFromPath,
  getLangStaticPaths,
  localizedPath,
} from "@/lib/i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].blog;
const blogPosts = getPostsForLang(await getCollection("blog"), lang);
const sortedPosts = sortPostsByDate(blogPosts);

const monthName = (year: number, month: number) =>
  new Date(year, month - 1, 1).toLocaleDateString(dateLocales[lang], {
    month: "long",
  });

const groupedArray = getDateGroups(sortedPosts, "month");
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <TitleLayout>
    <div slot="title" class="stack gap-md">
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
      <p>{content.thanks}</p>
    </div>

    <Fragment slot="content">
      {
        groupedArray.length === 0 ? (
          <p>{content.empty}</p>
        ) : (
          groupedArray.map((group) => {
            const month = group.month as number;
            const monthPadded = month.toString().padStart(2, "0");
            return (
              <section class="stack gap-md blog-group">
                <h2 class="body-sm text-soft blog-group-title">
                  <a
                    href={localizedPath(
                      lang,
                      `/blog/${group.year}/${monthPadded}`,
                    )}
                  >
                    {monthName(group.year, month)} {group.year}
                  </a>
                </h2>
                <BlogPostList posts={group.posts} lang={lang} />
              </section>
            );
          })
        )
      }
    </Fragment>
  </TitleLayout>
</BaseLayout>

<style>
  @layer styles {
    .blog-group-title {
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }
</style>
