---
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitleLayout from "../../layouts/TitleLayout.astro";
import {
  getCollection,
  render,
} from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import {
  getLangFromPath,
  getLangStaticPaths,
  localizedPath,
} from "../../lib/i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].interviews;
const page = (await getCollection("pages")).find(
  (entry) => entry.data.lang === lang && entry.data.page === "interviews",
);

if (!page) {
  throw new Error(`Missing interviews copy for ${lang}`);
}

const markdown = await createMarkdownProcessor({});
const { Content } = await render(page);
const renderExcerpt = async (excerpt: string) =>
  (await markdown.render(excerpt)).code;
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <TitleLayout>
    <Fragment slot="title">
      <h1>{content.title}</h1>
      {
        await Promise.all(
          page.data.excerpt?.map(async (paragraph) => (
            <p set:html={await renderExcerpt(paragraph)} />
          )) ?? [],
        )
      }
      {
        content.cta && (
          <a class="cta" href={localizedPath(lang, content.cta.href)}>
            {content.cta.label}
          </a>
        )
      }
    </Fragment>

    <Fragment slot="content">
      <Content />
    </Fragment>
  </TitleLayout>
</BaseLayout>
