---
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import { getLangFromPath, getLangStaticPaths } from "src/lib/i18n";
import { getPage } from "src/lib/pages";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].interviews;
const { Content } = await getPage(lang, "interviews");
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  noindex
>
  <Content />
</BaseLayout>
