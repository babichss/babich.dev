---
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangFromPath, getLangStaticPaths } from "../../lib/i18n";
import { getPage } from "../../lib/pages";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].interviews;
const { Content } = await getPage(lang, "interviews");
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <Content />
</BaseLayout>
