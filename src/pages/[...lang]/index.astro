---
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import { defaultLang, getLangFromPath, getLangStaticPaths } from "src/lib/i18n";
import { getPage } from "src/lib/pages";
import { personJsonLd } from "src/lib/seo";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].home;
const { Content } = await getPage(lang, "home");

const siteURL = Astro.site ?? Astro.url;
const home = new URL("/", siteURL).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: site.en.name,
      alternateName: "babich.dev",
      inLanguage: "en",
      publisher: { "@id": `${home}#person` },
    },
    {
      "@type": "ProfilePage",
      "@id": `${home}#profilepage`,
      url: home,
      name: site.en.home.metaTitle,
      inLanguage: "en",
      isPartOf: { "@id": `${home}#website` },
      mainEntity: { "@id": `${home}#person` },
    },
    personJsonLd(siteURL),
  ],
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  titleSuffix={false}
  ogType="profile"
>
  <Fragment slot="head">
    {
      lang === defaultLang && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </Fragment>

  <Content />
</BaseLayout>
