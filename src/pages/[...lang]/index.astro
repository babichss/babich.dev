---
import Nav from "src/components/Nav.astro";
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import HeroLayout from "src/layouts/HeroLayout.astro";
import { getLangFromPath, getLangStaticPaths } from "src/lib/i18n";
import { getPage } from "src/lib/pages";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].home;
const { Content } = await getPage(lang, "home");

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.en.name,
  jobTitle: "Senior Product Engineer",
  url: "https://babich.dev/en",
  sameAs: [
    "https://www.linkedin.com/in/babichss",
    "https://youtube.com/@babichweb",
  ],
  knowsLanguage: ["uk", "en"],
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
  </Fragment>

  <HeroLayout>
    <Fragment slot="header">
      <Nav />
    </Fragment>

    <Fragment slot="content">
      <Content />
    </Fragment>
  </HeroLayout>
</BaseLayout>
