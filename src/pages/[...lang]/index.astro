---
import Nav from "src/components/Nav.astro";
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import HeroLayout from "src/layouts/HeroLayout.astro";
import { getLangFromPath, getLangStaticPaths } from "src/lib/i18n";
import { getPage } from "src/lib/pages";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].home;
const { Content } = await getPage(lang, "home");
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <HeroLayout>
    <Fragment slot="header">
      <Nav />
    </Fragment>

    <Fragment slot="content">
      <Content />
    </Fragment>
  </HeroLayout>
</BaseLayout>
