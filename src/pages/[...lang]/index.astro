---
import Nav from "../../components/Nav.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroLayout from "../../layouts/HeroLayout.astro";
import { getCollection, render } from "astro:content";
import { getLangFromPath, getLangStaticPaths } from "../../lib/i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[lang].home;
const page = (await getCollection("pages")).find(
  (entry) => entry.data.lang === lang && entry.data.page === "home",
);

if (!page) {
  throw new Error(`Missing home copy for ${lang}`);
}

const { Content } = await render(page);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
>
  <HeroLayout>
    <Fragment slot="header">
      <Nav />
    </Fragment>

    <Fragment slot="content">
      <Content />
    </Fragment>
  </HeroLayout>
</BaseLayout>
