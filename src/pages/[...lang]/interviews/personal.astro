---
import { site } from "src/data/site";
import BaseLayout from "src/layouts/BaseLayout.astro";
import { defaultLang, getLangFromPath } from "src/lib/i18n";
import { getPage } from "src/lib/pages";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }];
}

const lang = getLangFromPath(Astro.url.pathname);
const content = site[defaultLang].personalInterview;
const { Content } = await getPage(defaultLang, "personal-interview");
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  noAlternateLang
  noindex
>
  <Content />
</BaseLayout>
